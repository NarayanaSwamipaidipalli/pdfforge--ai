# Doxera proposed Render configuration. No domain ownership or trademark clearance assumed.
# Do not copy over live credentials; set secrets only after owner approval.
NODE_ENV=production
LOAD_LOCAL_ENV=false
FRONTEND_URL=https://doxera.in
CORS_ORIGINS=https://doxera.in
NEXT_PUBLIC_APP_URL=https://doxera.in
GOOGLE_CALLBACK_URL=https://doxera.in/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=
REDIS_URL=
PDF_WORKER_HOSTPORT=
API_GATEWAY_HOSTPORT=
JWT_SECRET=
JWT_REFRESH_SECRET=
WORKER_CALLBACK_SECRET=
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Proposed sender only; set after Resend verifies the sending domain.
MAIL_FROM=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
ENABLE_RAZORPAY=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRICE_PRO_MONTHLY=
RAZORPAY_PRICE_PRO_YEARLY=
RAZORPAY_PRICE_BUSINESS_MONTHLY=
RAZORPAY_PRICE_BUSINESS_YEARLY=
RAZORPAY_PRICE_ENTERPRISE_MONTHLY=
RAZORPAY_PRICE_ENTERPRISE_YEARLY=
ENABLE_STRIPE=false
ENABLE_PAYPAL=false
SENTRY_DSN=
