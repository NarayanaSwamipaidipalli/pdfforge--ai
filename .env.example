# ==============================================================================
# PDFForge AI - Enterprise Production Environment Configuration
# ==============================================================================

# Core Application
NODE_ENV=production
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL 16
POSTGRES_USER=pdfforge
POSTGRES_PASSWORD=pdfforge_secure_pass_2026
POSTGRES_DB=pdfforge_db
DATABASE_URL=postgresql://pdfforge:pdfforge_secure_pass_2026@postgres:5432/pdfforge_db?schema=public

# Redis 7.4
REDIS_URL=redis://redis:6379

# Object Storage (MinIO S3-Compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=pdfforge-documents
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# JWT Authentication Secrets
JWT_SECRET=pdfforge-enterprise-jwt-super-secret-key-2026
JWT_REFRESH_SECRET=pdfforge-enterprise-refresh-secret-key-2026

# Internal Microservice Authentication Secret
WORKER_CALLBACK_SECRET=pdfforge-worker-internal-secret
API_GATEWAY_INTERNAL_URL=http://api-gateway:4000
PDF_WORKER_URL=http://pdf-worker:8000

# Payment Gateways (Stripe, Razorpay, PayPal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Error Monitoring (Sentry)
SENTRY_DSN=
