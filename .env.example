# ==============================================================================
# Doxera - Enterprise Production Environment Configuration
# ==============================================================================

# Core Application
# Docker: copy to .env.docker.local, supply existing credentials, then run:
# node scripts/docker/prepare-env.mjs --env-file .env.docker.local
# Always pass --env-file .env.docker.local to Docker Compose. Never replace existing database credentials.
NODE_ENV=production
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL 16
POSTGRES_USER=pdfforge
POSTGRES_PASSWORD=
POSTGRES_DB=pdfforge_db
DATABASE_URL=
# Derived by prepare-env.mjs for the internal Docker hostname and URL-encoded credentials.
# DATABASE_URL above remains available for native tools and is never overwritten by setup.
COMPOSE_DATABASE_URL=

# Redis 7.4
REDIS_URL=redis://redis:6379

# Object Storage (MinIO S3-Compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=pdfforge-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# JWT Authentication Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Internal Microservice Authentication Secret
WORKER_CALLBACK_SECRET=
API_GATEWAY_INTERNAL_URL=http://api-gateway:4000
PDF_WORKER_URL=http://pdf-worker:8000

# Google OAuth 2.0 Identity Platform
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Payment Gateways (Stripe, Razorpay, PayPal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ENABLE_RAZORPAY=false
ALLOW_RAZORPAY_LIVE=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

RAZORPAY_INR_PRO_MONTHLY_PAISE=99000
RAZORPAY_INR_PRO_YEARLY_PAISE=990000

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Error Monitoring (Sentry)
SENTRY_DSN=

# Production rejects missing/placeholder secrets. Supply unique random values externally.
# Razorpay prices below are integer INR paise; providers remain disabled until configured.
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=production
S3_AUTO_CREATE_BUCKET=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ENABLE_STRIPE=false
ENABLE_PAYPAL=false
PAYPAL_MODE=sandbox
RAZORPAY_PRICE_PRO_MONTHLY=
RAZORPAY_PRICE_PRO_YEARLY=
RAZORPAY_PRICE_BUSINESS_MONTHLY=
RAZORPAY_PRICE_BUSINESS_YEARLY=
RAZORPAY_PRICE_ENTERPRISE_MONTHLY=
RAZORPAY_PRICE_ENTERPRISE_YEARLY=
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:2136d593beacf4461187035eca949fe49abd589d5079735025c711ca58fee0c8
LOAD_LOCAL_ENV=false

# Transactional recovery: configure only after Resend sender verification.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
RAZORPAY_WEBHOOK_SECRET=
