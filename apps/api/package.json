{
  "name": "@pdfforge/api",
  "version": "1.0.0",
  "description": "Doxera Enterprise API Gateway & Core Microservice",
  "author": "Doxera Architecture Team",
  "private": true,
  "license": "UNLICENSED",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "prisma:seed": "prisma db seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^11.10.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "google-auth-library": "^11.3.2",
    "helmet": "^7.1.0",
    "openai": "^4.52.7",
    "razorpay": "^2.9.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^16.2.0",
    "uuid": "^11.1.1",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.11",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "js-yaml@^4.0.0": "^4.3.2",
    "lodash": "^4.18.1",
    "multer": "^2.5.0",
    "follow-redirects": "^1.16.2",
    "ws": "^8.22.1",
    "body-parser@^1.0.0": "^1.20.9",
    "qs": "^6.17.1",
    "tmp": "^0.2.7",
    "glob@^10.0.0": "^10.5.0",
    "picomatch@^4.0.0": "^4.0.7",
    "ajv@^8.0.0": "^8.20.0",
    "fast-uri@^3.0.0": "^3.1.9",
    "glob@^13.0.0": "^14.0.3",
    "js-yaml@^5.0.0": "^5.5.0"
  }
}
