PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=

# Redis Broker & Cache
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# AWS S3 / MinIO Object Storage
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=pdfforge-documents

# Python PDF Worker
PDF_WORKER_URL=http://localhost:8000
API_GATEWAY_INTERNAL_URL=http://localhost:4000
WORKER_CALLBACK_SECRET=

# OpenAI API Key
OPENAI_API_KEY=

# Payment Providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_ID=CHANGEME
SENTRY_DSN=

# Production rejects missing/placeholder secrets. Supply unique random values externally.
# Razorpay prices below are integer INR paise; providers remain disabled until configured.
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=production
S3_AUTO_CREATE_BUCKET=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ENABLE_STRIPE=false
ENABLE_PAYPAL=false
PAYPAL_MODE=sandbox
RAZORPAY_PRICE_PRO_MONTHLY=
RAZORPAY_PRICE_PRO_YEARLY=
RAZORPAY_PRICE_BUSINESS_MONTHLY=
RAZORPAY_PRICE_BUSINESS_YEARLY=
RAZORPAY_PRICE_ENTERPRISE_MONTHLY=
RAZORPAY_PRICE_ENTERPRISE_YEARLY=
MINIO_IMAGE=
LOAD_LOCAL_ENV=false

# Transactional recovery: configure only after Resend sender verification.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
