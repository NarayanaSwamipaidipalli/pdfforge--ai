# Names only for staging setup. This file is never automatically loaded.
# Use separate staging credentials and resources; do not copy development/production secrets.
# Render injects service/datastore references from render.staging.yaml.
NODE_ENV=production
ENVIRONMENT=production
LOAD_LOCAL_ENV=false
PORT=
FRONTEND_URL=
CORS_ORIGINS=
NEXT_PUBLIC_APP_URL=
API_GATEWAY_HOSTPORT=
PDF_WORKER_HOSTPORT=
DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
JWT_SECRET=
JWT_REFRESH_SECRET=
WORKER_CALLBACK_SECRET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_AUTO_CREATE_BUCKET=false
# Optional S3-compatible store only; use HTTPS and the same bucket/region on all services.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Required for client-side Google One-Tap. Use the same staging OAuth client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
SENTRY_DSN=
# Enable only after separately approved provider-sandbox setup; never use live credentials.
ENABLE_RAZORPAY=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRICE_PRO_MONTHLY=
RAZORPAY_PRICE_PRO_YEARLY=
RAZORPAY_PRICE_BUSINESS_MONTHLY=
RAZORPAY_PRICE_BUSINESS_YEARLY=
RAZORPAY_PRICE_ENTERPRISE_MONTHLY=
RAZORPAY_PRICE_ENTERPRISE_YEARLY=
ENABLE_STRIPE=false
ENABLE_PAYPAL=false
